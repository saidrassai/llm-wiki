# wiki-rag Environment Configuration
# Copy this file to .env and fill in your values

# LLM API Configuration (required for Phase 2 ingest)
LLM_API_KEY=your-api-key-here
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# Wiki Path (default: ~/wiki-rag)
WIKI_PATH=~/wiki-rag

# Collection Settings
WIKI_RAG_MAX_PAPERS=5
WIKI_RAG_TIMEOUT=60
